---
import Layout from '../layouts/Layout.astro';
import AnimatedLogo from '../components/AnimatedLogo.astro';
---

<Layout title="tiene.dev" splash>
  <section class="splash">
    <h1>
      <AnimatedLogo text="tiene.dev" animated />
    </h1>
  </section>
</Layout>

<style>
  .splash {
    display: grid;
    place-items: center;
    min-height: 100dvh;
    padding: 1rem;
  }
  .splash h1 {
    margin: 0;
    line-height: 0;
  }
</style>
